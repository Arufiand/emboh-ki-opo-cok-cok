{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*"
  ]
}
